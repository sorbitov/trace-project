{
  "name": "trace-arc",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.js",
    "contract:compile": "hardhat compile",
    "contract:deploy": "npm run contract:compile && node scripts/deploy-contract.js",
    "contract:smoke": "node scripts/smoke-contract.js",
    "indexer": "node scripts/indexer.js",
    "test": "npm run contract:compile && node --test --test-concurrency=1",
    "test:contracts": "npm run contract:compile && node --test --test-concurrency=1 test/contract.test.js",
    "check": "node --check server.js && node --check app/app.js && node --check app/wallet-provider.js && node --check app/project-page.js && node --check app/recipient-picker.js && node --check scripts/smoke-contract.js && npm run contract:compile"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "hardhat": "^3.9.1"
  }
}
